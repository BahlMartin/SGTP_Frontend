{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sgtp-backend-1.onrender.com/app/$1"
    },
    {
      "source": "/api",
      "destination": "https://sgtp-backend-1.onrender.com/app/"
    },

    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
