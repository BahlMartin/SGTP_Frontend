{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sgtp-backend.onrender.com/app/$1"
    },
    {
      "source": "/api",
      "destination": "https://sgtp-backend.onrender.com/app/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
