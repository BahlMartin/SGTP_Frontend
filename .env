# ========================================================
# Variables de Entorno - SGTP Frontend
# ========================================================

# En desarrollo y producción con proxy inverso, se utiliza /api por defecto (evita bloqueos de cookies de terceros y CORS).
# Si deseas conectar directamente sin proxy, descomenta la URL absoluta de Render:
VITE_API_URL=/api
# VITE_API_URL=https://sgtp-backend.onrender.com/app

# URL del microservicio OCR
VITE_OCR_SERVICE_URL=http://localhost:8001/ocr

# Cifrado JWE de payloads (opcional)
VITE_ENABLE_JWE=false
