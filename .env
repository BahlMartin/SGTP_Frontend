# ========================================================
# Variables de Entorno - SGTP Frontend
# ========================================================

# En desarrollo y producción con proxy inverso, se utiliza /api por defecto.
# Si deseas conectar directamente sin proxy, especifica la URL completa:
 VITE_API_URL=https://sgtp-backend.onrender.com/app
#VITE_API_URL=/api

# URL del microservicio OCR
VITE_OCR_SERVICE_URL=http://localhost:8001/ocr

# Cifrado JWE de payloads (opcional)
VITE_ENABLE_JWE=false
