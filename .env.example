# ========================================================
# Variables de Entorno - SGTP Frontend
# ========================================================

# URL base de la API REST del backend
# En local suele ser http://localhost:8000
# En producción con Vercel Proxy, puede dejarse vacío o definirse como /api
VITE_API_URL=http://localhost:8000

# URL del microservicio de inferencia de recetas médicas (OCR)
VITE_OCR_SERVICE_URL=http://localhost:8001/ocr

# Habilitar cifrado JWE de payloads (true / false)
VITE_ENABLE_JWE=false
